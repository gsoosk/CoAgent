# Copy to .env and fill in whichever provider you want. .env is gitignored
# and is never printed by any script.

# --- Reproduces the paper's setup (deepseek-v4-flash via OpenRouter) -------
# openrouter.ai -> Keys -> Create API Key.  ~$2 for the full 500-trial matrix.
OPENROUTER_API_KEY=sk-or-v1-...

# --- DeepSeek first-party instead (same OpenAI-compatible protocol) --------
# platform.deepseek.com -> API keys.  Model names differ: use
#   --model deepseek-flash
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_BASE_URL=https://api.deepseek.com/v1

# --- Measures a different model's self-healing rate ------------------------
# ANTHROPIC_API_KEY=sk-ant-...
